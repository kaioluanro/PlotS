{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlotS",
  "mainBinaryName": "PlotS",
  "version": "1.0.0-alpha",
  "identifier": "io.github.kaioluanro.plots",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "abertura",
        "title": "PlotS",
        "url": "abertura.html",
        "width": 480,
        "height": 300,
        "center": true,
        "backgroundColor": "#0d0e12",
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "skipTaskbar": true
      },
      {
        "label": "main",
        "visible": false,
        "title": "PlotS",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 420,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "Kaio Luan",
    "copyright": "Copyright (c) 2026 Kaio Luan",
    "shortDescription": "PlotS: impressão frente e verso manual",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "../scripts/instalador/hooks.nsh",
        "languages": ["PortugueseBR", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
