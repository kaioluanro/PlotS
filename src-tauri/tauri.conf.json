{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlotS",
  "version": "0.1.0",
  "identifier": "io.github.kaioluanro.plots",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "abertura",
        "title": "PlotS",
        "url": "abertura.html",
        "width": 480,
        "height": 300,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "skipTaskbar": true
      },
      {
        "label": "main",
        "visible": false,
        "title": "PlotS",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 420,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
